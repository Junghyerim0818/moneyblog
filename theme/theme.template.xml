<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' b:templateVersion='1.0.0' expr:dir='data:blog.languageDirection' lang='ko' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <b:if cond='data:view.isHomepage'>
    <title><data:blog.title/></title>
  <b:else/>
    <title><data:view.title.escaped/> | <data:blog.title/></title>
  </b:if>
  <b:include data='blog' name='all-head-content'/>
  <meta content='#FFFFFF' name='theme-color'/>
  <link crossorigin='anonymous' href='https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css' rel='stylesheet'/>
  <b:skin version='1.0.0'><![CDATA[
/*{{CSS}}*/
  ]]></b:skin>
</head>
<body>

<!-- ───────── 상단 바 : 카테고리 링크는 여기서 수정 ───────── -->
<header class='top'>
  <div class='wrap'>
    <b:section class='brand' id='header' maxwidgets='1' showaddelement='no'>
      <b:widget id='Header1' locked='true' title='블로그 제목' type='Header' version='2'>
        <b:includable id='main'>
          <a class='logo' expr:href='data:blog.homepageUrl'><i>₩</i><data:title/></a>
        </b:includable>
      </b:widget>
    </b:section>
    <nav class='nav'>
      <a expr:href='data:blog.homepageUrl + &quot;search/label/증권금융&quot;'>증권·금융</a>
      <a expr:href='data:blog.homepageUrl + &quot;search/label/경제&quot;'>경제</a>
      <a expr:href='data:blog.homepageUrl + &quot;search/label/절세&quot;'>절세</a>
    </nav>
  </div>
  <div class='progress' id='progress'/>
</header>

<main class='wrap'>
  <b:section class='main' id='main' showaddelement='no'>
    <b:widget id='Blog1' locked='true' title='블로그 글' type='Blog' version='2'>
      <b:includable id='main' var='top'>

        <b:if cond='data:view.isMultipleItems'>
          <!-- ───────── 목록 화면 (메인·카테고리·검색) ───────── -->
          <b:if cond='data:view.isHomepage'>
            <section class='hero'>
              <h1>어려운 돈 이야기,<br/><b>숫자 하나</b>로 정리합니다</h1>
              <p>주식·금융·경제·절세를 그래프와 표로 3분 안에.</p>
              <div class='chips'>
                <a expr:href='data:blog.homepageUrl + &quot;search/label/주식기초&quot;'>📈 주식 기초</a>
                <a expr:href='data:blog.homepageUrl + &quot;search/label/경제용어&quot;'>📖 뉴스 속 경제 용어</a>
                <a expr:href='data:blog.homepageUrl + &quot;search/label/연말정산&quot;'>🧾 연말정산</a>
                <a expr:href='data:blog.homepageUrl + &quot;search/label/연금저축&quot;'>🏦 연금저축·IRP</a>
              </div>
            </section>
            <div class='section-title'><h2>최신 글</h2></div>
          <b:elseif cond='data:view.isLabelSearch'/>
            <section class='hero'><h1><b><data:view.search.label/></b></h1><p>카테고리 글 모음</p></section>
          <b:else/>
            <section class='hero'><h1>검색 결과</h1></section>
          </b:if>

            <div class='grid'>
              <b:loop index='i' values='data:posts' var='post'>
                <a class='card' expr:href='data:post.url'>
                  <b:class cond='data:view.isHomepage and data:i == 0' name='is-featured'/>
                  <b:if cond='data:post.featuredImage'>
                    <div class='thumb'><img expr:alt='data:post.title' expr:src='resizeImage(data:post.featuredImage, 800, &quot;1200:630&quot;)' loading='lazy'/></div>
                  <b:else/>
                    <div class='thumb empty'><data:blog.title/></div>
                  </b:if>
                  <div class='txt'>
                    <b:if cond='data:post.labels'>
                      <b:loop index='j' values='data:post.labels' var='label'>
                        <b:if cond='data:j == 0'><div class='lab'><data:label.name/></div></b:if>
                      </b:loop>
                    </b:if>
                    <h3><data:post.title/></h3>
                    <p><data:post.snippets.short/></p>
                    <time><data:post.date/></time>
                  </div>
                </a>
              </b:loop>
            </div>

          <div class='pager'>
            <b:if cond='data:newerPageUrl'><a expr:href='data:newerPageUrl'>← 최신 글</a></b:if>
            <b:if cond='data:olderPageUrl'><a expr:href='data:olderPageUrl'>이전 글 →</a></b:if>
          </div>

        <b:else/>
          <!-- ───────── 글 화면 ───────── -->
          <b:if cond='data:blog.pageType == &quot;error_page&quot;'>
            <section class='notfound'>
              <div class='code'>404</div>
              <h1>찾는 페이지가 없어요</h1>
              <p>주소가 바뀌었거나 아직 발행되지 않은 글일 수 있어요.</p>
              <a class='btn' expr:href='data:blog.homepageUrl'>홈으로 가기</a>
            </section>
          </b:if>
          <b:loop values='data:posts' var='post'>
            <article class='post'>
              <b:if cond='data:post.labels'>
                <b:loop index='j' values='data:post.labels' var='label'>
                  <b:if cond='data:j == 0'><a class='crumb' expr:href='data:label.url'><data:label.name/></a></b:if>
                </b:loop>
              </b:if>
              <h1><data:post.title/></h1>
              <div class='meta'>
                <span><data:blog.title/></span><span class='dot'/><time><data:post.date/></time>
              </div>
              <div class='post-body' id='post-body'><data:post.body/></div>
              <b:if cond='data:post.labels'>
                <div class='post-labels' id='post-labels'>
                  <b:loop values='data:post.labels' var='label'>
                    <a expr:href='data:label.url'>#<data:label.name/></a>
                  </b:loop>
                </div>
              </b:if>
            </article>
            <b:if cond='data:view.isPost'>
              <section class='related' id='related' style='display:none'>
                <h2>같은 주제 다른 글</h2>
                <div class='grid' id='related-grid'/>
              </section>
            </b:if>
          </b:loop>
        </b:if>

      </b:includable>
    </b:widget>
  </b:section>

  <!-- 레이아웃 메뉴에서 애드센스·인기글 등 가젯을 추가하는 자리 -->
  <b:section class='extra' id='extra' showaddelement='yes'/>
</main>

<footer class='foot'>
  <div class='wrap'>
    <span>© <data:blog.title/> · 투자 판단의 책임은 본인에게 있습니다.</span>
    <span><a expr:href='data:blog.homepageUrl + &quot;p/about.html&quot;'>소개</a><a expr:href='data:blog.homepageUrl + &quot;p/privacy.html&quot;'>개인정보처리방침</a><a expr:href='data:blog.homepageUrl + &quot;p/contact.html&quot;'>문의</a></span>
  </div>
</footer>

<script>//<![CDATA[
(function(){
  document.querySelectorAll('.grid:not(#related-grid)').forEach(function(g){
    if(!g.querySelector('.card')){var d=document.createElement('div');d.className='empty-state';d.innerHTML='<b>첫 글을 준비하고 있어요</b><span>곧 그래프로 정리한 돈 이야기가 올라옵니다.</span>';g.replaceWith(d);}
  });
  var bar=document.getElementById('progress'), body=document.getElementById('post-body');
  if(bar && body){
    window.addEventListener('scroll',function(){
      var r=body.getBoundingClientRect(), h=body.offsetHeight-window.innerHeight;
      var p=Math.min(100,Math.max(0,(-r.top)/(h>0?h:1)*100));
      bar.style.width=p+'%';
    },{passive:true});
  }
  /* 넓은 표는 가로 스크롤 */
  if(body){
    var ts=body.getElementsByTagName('table');
    for(var i=0;i<ts.length;i++){var t=ts[i];if(t.parentNode.className!=='table-scroll'){var w=document.createElement('div');w.className='table-scroll';t.parentNode.insertBefore(w,t);w.appendChild(t);}}
  }
  /* 같은 라벨 글 4개 */
  var labs=document.getElementById('post-labels'), box=document.getElementById('related');
  if(!labs || !box) return;
  var first=labs.getElementsByTagName('a')[0]; if(!first) return;
  var label=first.textContent.replace(/^#/,'');
  var here=location.href.split('?')[0].split('#')[0];
  var cb='mgRelated'+Date.now();
  window[cb]=function(json){
    var es=(json.feed&&json.feed.entry)||[], html='', n=0;
    for(var i=0;i<es.length&&n<4;i++){
      var e=es[i], url='';
      for(var k=0;k<e.link.length;k++){if(e.link[k].rel==='alternate'){url=e.link[k].href;}}
      if(!url||url===here) continue;
      var img=e.media$thumbnail?e.media$thumbnail.url.replace(/\/s72(-c)?\//,'/w600-h315-p-k-no-nu/').replace(/=s72(-c)?$/,'=w600-h315-p-k-no-nu'):'';
      html+='<a class="card" href="'+url+'">'+(img?'<div class="thumb"><img loading="lazy" src="'+img+'" alt=""></div>':'<div class="thumb empty"></div>')+'<h3>'+e.title.$t+'</h3></a>';
      n++;
    }
    if(n){document.getElementById('related-grid').innerHTML=html;box.style.display='';}
  };
  var s=document.createElement('script');
  s.src='/feeds/posts/summary/-/'+encodeURIComponent(label)+'?alt=json-in-script&max-results=6&callback='+cb;
  document.body.appendChild(s);
})();
//]]></script>
</body>
</html>
